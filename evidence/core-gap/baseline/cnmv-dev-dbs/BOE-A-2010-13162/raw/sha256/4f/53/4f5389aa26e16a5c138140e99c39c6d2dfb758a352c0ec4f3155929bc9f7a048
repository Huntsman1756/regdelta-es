        <col class="row_column_3"/>
      </colgroup>
      <thead>
        <tr class="row_column_4">
          <td>
            <p class="cabeza_tabla">Estado-Denominación</p>
          </td>
          <td>
            <p class="cabeza_tabla">Periodicidad/Periodo al que se refiere</p>
          </td>
          <td>
            <p class="cabeza_tabla">Plazo máximo de presentación</p>
          </td>
        </tr>
      </thead>
      <tbody>
        <tr class="row_column_5">
          <td>
            <p class="cuerpo_tabla_izq">T1. Datos societarios y personas de contacto.</p>
          </td>
          <td>
            <p class="cuerpo_tabla_izq">Anual (año natural).</p>
          </td>
