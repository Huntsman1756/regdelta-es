      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/">
         <xmp:ModifyDate>2015-12-29T15:40:09+01:00</xmp:ModifyDate>
         <xmp:CreateDate>2015-12-28T22:40:13+01:00</xmp:CreateDate>
         <xmp:MetadataDate>2015-12-29T15:40:09+01:00</xmp:MetadataDate>
      </rdf:Description>
      <rdf:Description rdf:about=""
